ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=3306
DB_USER=insightease_app
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=insightease

# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-output-of-openssl-rand
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HERMES_ASSISTANT_ENABLED=false
HERMES_ASSISTANT_MODE=disabled
# HERMES_BASE_URL=https://hermes.example.com/v1
# HERMES_AUTH_TOKEN=inject-through-your-secret-manager
HERMES_MODEL=hermes-agent
HERMES_ASSISTANT_TIMEOUT_MS=10000

# Optional object storage. Leave blank to use local storage.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_REGION=
